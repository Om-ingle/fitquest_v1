# Copy this file to .env (apps/api/.env or the repository root .env) and fill
# in real values. Never commit a .env containing real credentials.

# App
APP_NAME=FitQuest API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Security (dev placeholder — real Supabase Auth is a later phase)
SUPABASE_JWT_SECRET=change-me

# Database — PostgreSQL connection to Supabase (required)
# Direct (IPv6-only — fails on networks without an IPv6 route):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Pooler (IPv4-compatible, session mode — see Supabase Dashboard -> Database -> Connection pooling):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Backend-only Supabase values (optional in Phase 1 — not used by the code yet)
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=

# ── AI providers (Phase 4C.2) — backend-only, NEVER in Android ──────────────
# ONE Google AI Studio key powers BOTH the embedding provider and the LLM.
# Get one at https://aistudio.google.com/apikey. Without it, /api/v1/coach
# returns 503 and RAG ingestion refuses to run (no fake embeddings).
GEMINI_API_KEY=
# Optional overrides (defaults shown):
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_LLM_MODEL=gemini-2.5-flash
# EMBEDDING_TIMEOUT_SECONDS=30.0
# LLM_TIMEOUT_SECONDS=30.0
# RAG_SIMILARITY_THRESHOLD=0.50
# COACH_TOP_K=4

# ── Alternate LLM provider (Phase 4C.3B) — optional, backend-only ──────────
# Switch the coach TEXT GENERATION to an OpenAI-compatible gateway when the
# Gemini free-tier generateContent quota is exhausted. Embeddings stay on
# Gemini (gemini-embedding-001) regardless — separate quota, and the pgvector
# schema is frozen to 1536 dims. Gemini remains the default when unset.
# LLM_PROVIDER=gemini            # or: agentrouter
# AGENTIC_API_KEY=
# AGENTROUTER_BASE_URL=https://your-gateway.example.com/v1
# AGENTROUTER_MODEL=deepseek-v4-flash
