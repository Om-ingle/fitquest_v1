# Copy this file to .env and set your local values. .env is gitignored; this
# example file is not, so nothing secret may ever be written here.
MAPTILER_API_KEY="5LqIwCkHS7bVkv6Xjs90"
MAPTILER_STYLE_URL=https://api.maptiler.com/maps/streets/style.json?key=${MAPTILER_API_KEY}

# FastAPI backend base URL used for run sync and the coaching WebSocket
# (Android side only). The default targets the Android emulator's alias for the
# host machine's localhost:
#   emulator:  http://10.0.2.2:8000/
#   real device on the same Wi-Fi as the backend: http://<YOUR_PC_LAN_IP>:8000/
BACKEND_BASE_URL=http://10.0.2.2:8000/

# ── M11: Supabase Auth ──────────────────────────────────────────────────────
# Both values are compiled into BuildConfig. Leave them unset and the app still
# builds and runs; sign-in then reports "not configured" instead of crashing.
#
# SUPABASE_URL is the project URL from the Supabase dashboard (Settings -> API).
# A trailing slash, or the /auth/v1 suffix copied from the docs, are both
# accepted. SUPABASE_ANON_KEY is that page's "anon / publishable" key: it is
# designed to ship inside client apps, it identifies the PROJECT rather than a
# user, and it grants nothing on its own. Access is decided by the user's
# signed-in token, which the FastAPI backend verifies against the project's
# published keys (ES256 JWKS).
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_ANON_KEY="<your-project-anon-publishable-key>"

# NEVER put these here, or anywhere in the Android app:
#   * the Supabase SERVICE-ROLE key — it bypasses Row Level Security, and anyone
#     who unzips the APK would hold the whole database;
#   * DATABASE_URL / the database password — the app never talks to Postgres
#     directly; it goes through the FastAPI backend, which owns that credential
#     (see apps/api/.env).
