<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds talk to the local FastAPI backend over plain HTTP
         (BuildConfig.BACKEND_BASE_URL, e.g. http://10.0.2.2:8000/ on the
         emulator or a LAN IP for physical-device testing). Android 9+
         blocks cleartext traffic by default, which would break every
         backend call (run sync, leaderboard, map, recommendations) —
         so debug builds explicitly permit it.

         Release builds are unaffected: they must use an HTTPS backend. -->
    <application android:usesCleartextTraffic="true" />

</manifest>
